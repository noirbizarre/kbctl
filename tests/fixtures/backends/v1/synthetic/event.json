{
  "schema_version": 1,
  "id": "synthetic.event.v1",
  "origin": { "kind": "synthetic", "procedure": "Constructed asynchronous input around a gated toy serial reply", "sanitization": "Generated status values only; no hardware trace or personal data" },
  "device": { "model": "Synthetic keyboard", "revision": "fixture-v1", "firmware": "synthetic-r4" },
  "protocol": { "id": "kbctl.synthetic.serial", "version": "1" },
  "purpose": "Deliver unsolicited battery state while a firmware request waits for a reply",
  "endpoints": [{
    "alias": "main", "transport": "serial", "gates": ["read-written", "reply-ready"], "idle": ["serial_read"],
    "steps": [
      { "id": "handshake", "op": "serial_read", "outcome": { "kind": "input", "bytes": [1, 0, 126] } },
      { "id": "read-request", "op": "serial_write", "releases": "read-written", "outcome": { "kind": "output", "bytes": [17, 0] } },
      { "id": "event", "op": "serial_read", "after": "read-written", "outcome": { "kind": "input", "bytes": [2, 0, 160, 42] } },
      { "id": "read-reply", "op": "serial_read", "after": "reply-ready", "outcome": { "kind": "input", "bytes": [3, 0, 145, 114, 52] } }
    ]
  }]
}
